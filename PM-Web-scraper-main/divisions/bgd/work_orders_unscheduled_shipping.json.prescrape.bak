    "equipment_name": "Staple Gun",
    "department": "Shipping",
    "wo_id": "10093",
    "date_notified": "01/24/2024",
    "urgency": "4. Prod Continuing but Affected Equipment stopped",
    "problem": "The staple will not release the staples.",
    "status": "Closed and Completed",
    "material_cost": "0",
