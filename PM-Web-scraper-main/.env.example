# Copy this file to ".env" and fill in your real keys. Never commit .env.
GEMINI_API_KEY=your_gemini_key_here
OLLAMA_API_KEY=your_ollama_cloud_key_here

# Optional overrides
# LLM_PROVIDER=ollama            # "ollama" (default when OLLAMA_API_KEY set) or "gemini"
# OLLAMA_MODEL=gpt-oss:120b
# GEMINI_MODEL=gemini-2.5-flash

# --- Nightly update / server configuration (all optional) ---
# NIGHTLY_HOUR=2                 # 0-23, local time the nightly rescrape runs (default 2 = 2 AM)
# NIGHTLY_MINUTE=0
# NIGHTLY_ENABLED=1             # set 0 to disable the scheduled nightly job
# SERVER_HOST=0.0.0.0          # bind address (0.0.0.0 = reachable on your LAN)
# SERVER_PORT=5000
# CHROME_PROFILE=               # path to the logged-in Chrome debug profile
# CHROME_DEBUG_PORT=0          # 0 = auto-pick a free port and capture it

# --- Company / divisions ---
# COMPANY_NAME=Bobrick          # name shown on the top (company) layer

# --- Passwords (optional; blank = that action stays OPEN/unprotected) ---
# EDIT_PASSWORD gates editing the troubleshooting checklists.
# ADMIN_PASSWORD gates deleting work orders + viewing a work order's version
# history. Set it to require a password for those two actions.
# EDIT_PASSWORD=your_edit_password_here
# ADMIN_PASSWORD=your_admin_password_here

# --- Email notifications (OFF until configured; see mint_email.py) ---
# Leave EMAIL_ENABLED unset/0 to keep emails in dry-run (logged, not sent).
# Add recipients via the app (Email settings) or mint_data/email_recipients.json.
# EMAIL_ENABLED=1
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=maintenance@bobrick.com
# SMTP_PASSWORD=your_app_password_here
# SMTP_FROM=maintenance@bobrick.com
# SMTP_STARTTLS=1
